{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optimization output manifest v3",
  "type": "object",
  "required": [
    "schema",
    "version",
    "profile",
    "stage",
    "inputHash",
    "outputHash",
    "releaseId",
    "assets",
    "toolchain"
  ],
  "properties": {
    "schema": {
      "const": "model-optimizer.optimization-manifest"
    },
    "version": {
      "const": 3
    },
    "profile": {
      "const": "web-v1"
    },
    "stage": {
      "const": "publication"
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outputHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "releaseId": {
      "type": "string"
    },
    "assets": {
      "type": "array"
    },
    "toolchain": {
      "type": "object"
    }
  },
  "$id": "urn:model-optimizer:schemas:optimization-manifest:3"
}
