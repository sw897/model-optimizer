{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/model-optimizer.lod-manifest.v2.json",
  "title": "model input LOD manifest v2",
  "type": "object",
  "required": ["schema", "version", "baseSceneHash", "basePrototypeManifestHash", "toolchain", "prototypes"],
  "properties": {
    "schema": { "const": "model-optimizer.lod-manifest" },
    "version": { "const": 2 },
    "baseSceneHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "basePrototypeManifestHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "toolchain": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "binarySha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      },
      "additionalProperties": false
    },
    "prototypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["prototypeId", "baseSha256", "lods"],
        "properties": {
          "prototypeId": { "type": "string", "minLength": 1 },
          "baseSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "lods": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["level", "path", "geometricErrorMeters", "method", "sha256", "inputSha256", "tool", "toolVersion"],
              "properties": {
                "level": { "type": "integer", "minimum": 1 },
                "path": { "type": "string", "minLength": 1 },
                "geometricErrorMeters": { "type": "number", "minimum": 0 },
                "method": { "const": "meshopt-simplify" },
                "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
                "inputSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
                "tool": { "const": "meshoptimizer" },
                "toolVersion": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
