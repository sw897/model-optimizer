{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:model-optimizer:schemas:lod-manifest:3",
  "title": "model input LOD manifest v3",
  "type": "object",
  "required": [
    "schema",
    "version",
    "baseBuildManifestHash",
    "basePrototypeManifestHash",
    "toolchain",
    "prototypes",
    "sceneId"
  ],
  "properties": {
    "schema": {
      "const": "model-optimizer.lod-manifest"
    },
    "version": {
      "const": 3
    },
    "basePrototypeManifestHash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "toolchain": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "binarySha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      },
      "additionalProperties": false
    },
    "prototypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "prototypeId",
          "baseSha256",
          "lods",
          "status"
        ],
        "properties": {
          "prototypeId": {
            "type": "string",
            "minLength": 1
          },
          "baseSha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "lods": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "level",
                "path",
                "geometricErrorMeters",
                "method",
                "sha256",
                "inputSha256",
                "tool",
                "toolVersion"
              ],
              "properties": {
                "level": {
                  "type": "integer",
                  "minimum": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "geometricErrorMeters": {
                  "type": "number",
                  "minimum": 0
                },
                "method": {
                  "const": "meshopt-simplify"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "inputSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "tool": {
                  "const": "meshoptimizer"
                },
                "toolVersion": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "status": {
            "enum": [
              "succeeded",
              "base-only"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "baseBuildManifestHash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "sceneId": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
