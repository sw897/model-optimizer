{
  "schema": "model-optimizer.lod-toolchain",
  "version": 1,
  "name": "meshoptimizer-gltf-transform",
  "worker": "model-optimizer",
  "workerVersion": "0.4.0",
  "node": ">=20.9.0",
  "packages": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "basisu": "1.16.3",
    "draco3dgltf": "1.5.7",
    "meshoptimizer": "1.2.0",
    "sharp": "0.35.5"
  },
  "method": "meshopt-simplify",
  "optimization": {
    "profile": "web-v1",
    "geometryCompression": "meshopt",
    "textureCompression": "ktx2",
    "textureEncoder": "basisu@1.16.3",
    "nativeToolsLock": "native-tools.lock.json",
    "positionPrecision": "lossless",
    "resourceModel": "standard-tileset-shared-buffers"
  }
}
