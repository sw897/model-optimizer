{
  "name": "model-optimizer",
  "version": "0.2.0",
  "private": true,
  "description": "Deterministic LOD and web-asset optimization workers for model scenes",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "schemas",
    "toolchain.lock.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "model-lod-worker": "dist/cli.js",
    "model-opt-worker": "dist/opt-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/cli.js dist/opt-cli.js",
    "package": "npm run build && node scripts/package-release.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "basisu": "1.16.3",
    "draco3dgltf": "1.5.7",
    "meshoptimizer": "1.2.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
