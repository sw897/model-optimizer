{
  "name": "model-optimizer",
  "version": "0.4.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Standard 3D Tiles LOD and GLB/tileset web optimization workers",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs",
    "examples",
    "schemas",
    "vendor",
    "native-tools.lock.json",
    "toolchain.lock.json"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "bin": {
    "model-lod-worker": "dist/cli.js",
    "model-opt-worker": "dist/opt-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/postbuild.mjs",
    "package": "node scripts/package-release.mjs",
    "package:portable": "node scripts/package-portable.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "check:release": "node scripts/check-release.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:portable": "node scripts/test-portable.mjs",
    "check:portable": "node scripts/check-portable.mjs",
    "prepare:wine": "node scripts/prepare-portable-wine.mjs",
    "build:encoder:windows": "node scripts/build-basisu-windows.mjs",
    "example": "node examples/generate.mjs",
    "audit:dependencies": "node scripts/npm.mjs audit --audit-level=high",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "basisu": "1.16.3",
    "draco3dgltf": "1.5.7",
    "meshoptimizer": "1.2.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "fflate": "0.8.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "4.1.12"
  },
  "keywords": [
    "gltf",
    "glb",
    "3d-tiles",
    "meshopt",
    "ktx2",
    "lod"
  ]
}
